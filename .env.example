# ============================================================
# TasmiqAI Backend — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ============================================================

# ── Gemini AI (speech-to-text) ────────────────────────────
# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Supabase (database) ───────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── JWT Authentication ────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be set in production. If not set, a random key is used (tokens
# are lost on every server restart).
JWT_SECRET=
JWT_EXPIRE_HOURS=72

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Development default (already built-in if this is unset):
#   http://localhost:3000,http://localhost:5173,http://localhost:8081
# Production example:
#   ALLOWED_ORIGINS=https://api.tasmiqai.com,https://portal.tasmiqai.com
ALLOWED_ORIGINS=

# ── Quran Dataset Path ────────────────────────────────────
# Path to the directory containing audio/ and surah/ subdirectories.
# Default (relative, works without setting this): ./data/quran/source
# Production example: /opt/tasmiqai/data/quran/source
QURAN_DATA_DIR=

# ── Backend Server (informational — not used by uvicorn directly) ─
API_URL=http://localhost:8001
